<Window x:Class="ChairOSC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChairOSC" Height="560" Width="640" WindowStartupLocation="CenterScreen"
        Icon="/chair.ico">
  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="Idle"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="EspStatusText" Text="ESP: unknown"/></StatusBarItem>
    </StatusBar>

    <TabControl Margin="6">
      <TabItem Header="Connection">
        <Grid Margin="10" >
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Label Grid.Row="0" Grid.Column="0" Content="ESP Host (IP)"/>
          <TextBox Grid.Row="0" Grid.Column="1" x:Name="EspHostBox" Margin="0,3"/>

          <Label Grid.Row="1" Grid.Column="0" Content="OSC Bind IP"/>
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="OscBindBox" Margin="0,3"/>

          <Label Grid.Row="2" Grid.Column="0" Content="OSC Port"/>
          <TextBox Grid.Row="2" Grid.Column="1" x:Name="OscPortBox" Margin="0,3"/>

          <Label Grid.Row="3" Grid.Column="0" Content="Heat Switch Entity"/>
          <TextBox Grid.Row="3" Grid.Column="1" x:Name="HeatEntityBox" Margin="0,3"/>

          <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Vertical" Margin="0,8">
            <CheckBox x:Name="EnabledBox" Content="Enabled"/>
            <CheckBox x:Name="StartToTrayBox" Margin="0,4,0,0" Content="Start minimised to tray (skip window on launch)"/>
          </StackPanel>

          <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,8">
            <Button x:Name="ApplyBtn" Content="Apply &amp; Save" Padding="12,4" Margin="0,0,6,0"/>
            <Button x:Name="PingBtn" Content="Ping ESP" Padding="12,4" Margin="0,0,6,0"/>
            <Button x:Name="ReconnectBtn" Content="Restart OSC Listener" Padding="12,4"/>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Velocity">
        <Grid Margin="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Label Grid.Row="0" Grid.Column="0" Content="Base intensity (touch)"/>
          <TextBox Grid.Row="0" Grid.Column="1" x:Name="BaseIntensityBox" Margin="0,3"/>

          <Label Grid.Row="1" Grid.Column="0" Content="Velocity scale"/>
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="VelocityScaleBox" Margin="0,3"/>

          <Label Grid.Row="2" Grid.Column="0" Content="Touch threshold"/>
          <TextBox Grid.Row="2" Grid.Column="1" x:Name="TouchThresholdBox" Margin="0,3"/>

          <Label Grid.Row="3" Grid.Column="0" Content="Velocity window (ms)"/>
          <TextBox Grid.Row="3" Grid.Column="1" x:Name="WindowMsBox" Margin="0,3"/>

          <Label Grid.Row="4" Grid.Column="0" Content="Max intensity (clamp)"/>
          <TextBox Grid.Row="4" Grid.Column="1" x:Name="MaxIntensityBox" Margin="0,3"/>

          <Label Grid.Row="5" Grid.Column="0" Content="ESP min update interval (ms)"/>
          <TextBox Grid.Row="5" Grid.Column="1" x:Name="EspMinIntervalBox" Margin="0,3"/>

          <TextBlock Grid.Row="6" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,12" FontSize="11" Foreground="Gray">
            intensity = max(BaseIntensity, VelocityScale × |dProximity/dt|) when proximity > TouchThreshold, else 0. Clamped to MaxIntensity. ESP writes throttled by min interval per hardware zone.
          </TextBlock>
        </Grid>
      </TabItem>

      <TabItem Header="Test">
        <StackPanel Margin="10">
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">Direct override sliders. Bypasses OSC entirely — writes the slider value straight to the ESP intensity entity for that hardware zone. Use to identify which physical body region each zone vibrates.</TextBlock>

          <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="80"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="50"/>
              <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="32"/>
              <RowDefinition Height="32"/>
              <RowDefinition Height="32"/>
              <RowDefinition Height="32"/>
              <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Zone 1"/>
            <Slider Grid.Row="0" Grid.Column="1" x:Name="Z1Slider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" />
            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="Z1Value" Text="0.00" VerticalAlignment="Center"/>
            <Button Grid.Row="0" Grid.Column="3" x:Name="Z1Send" Content="Send" Margin="4,2"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Zone 2"/>
            <Slider Grid.Row="1" Grid.Column="1" x:Name="Z2Slider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" />
            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="Z2Value" Text="0.00" VerticalAlignment="Center"/>
            <Button Grid.Row="1" Grid.Column="3" x:Name="Z2Send" Content="Send" Margin="4,2"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Zone 3"/>
            <Slider Grid.Row="2" Grid.Column="1" x:Name="Z3Slider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" />
            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="Z3Value" Text="0.00" VerticalAlignment="Center"/>
            <Button Grid.Row="2" Grid.Column="3" x:Name="Z3Send" Content="Send" Margin="4,2"/>

            <Label Grid.Row="3" Grid.Column="0" Content="Zone 4"/>
            <Slider Grid.Row="3" Grid.Column="1" x:Name="Z4Slider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" />
            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="Z4Value" Text="0.00" VerticalAlignment="Center"/>
            <Button Grid.Row="3" Grid.Column="3" x:Name="Z4Send" Content="Send" Margin="4,2"/>

            <Label Grid.Row="4" Grid.Column="0" Content="Heat"/>
            <CheckBox Grid.Row="4" Grid.Column="1" x:Name="HeatToggle" VerticalAlignment="Center" Content="On"/>
            <Button Grid.Row="4" Grid.Column="3" x:Name="HeatSend" Content="Send" Margin="4,2"/>
          </Grid>
          <Button x:Name="AllOffBtn" Content="All Zones Off" Padding="12,6" Margin="0,12" HorizontalAlignment="Left"/>
        </StackPanel>
      </TabItem>

      <TabItem Header="Logs">
        <DockPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="6">
            <Button x:Name="ClearLogBtn" Content="Clear" Padding="10,2"/>
          </StackPanel>
          <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="11"/>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
